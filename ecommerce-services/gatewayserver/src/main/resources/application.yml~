spring:
 application:
  name: "gatewayserver"
 config:
  import: "optional:configserver:http://localhost:8888/"

management:
 endpoints:
  web:
   exposure:
    include: "*"
 info:
  env:
   enabled: true
 endpoint:
  access: unrestricted
  gateway:
   access: unrestricted


eureka:
 instance:
  preferIpAddress: true
 client:
  fetchRegistry: true
  registerWithEureka: true
  serviceUrl:
   defaultZone: http://localhost:8070/eureka/

info:
 app:
  name: "gatewayserver"
  description: "Gateway server for ecommerce backend application"
  version: "1.0.0"



